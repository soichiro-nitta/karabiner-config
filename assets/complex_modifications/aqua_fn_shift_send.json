{
  "title": "Aqua: Fn + Right Ctrl then send on Ctrl down",
  "rules": [
    {
      "description": "When Fn was pressed, Enter on right_control key down",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "fn" },
          "to": [
            { "set_variable": { "name": "fn_voice_mode", "value": 1 } },
            { "key_code": "fn" }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "right_control" },
          "conditions": [
            {
              "type": "variable_if",
              "name": "fn_voice_mode",
            "value": 1
          }
        ],
          "to": [
            { "key_code": "return_or_enter" },
            {
              "set_variable": {
                "name": "fn_voice_mode",
                "value": 0
              }
            }
          ]
        }
      ]
    }
  ]
}
